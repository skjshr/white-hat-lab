; Godot 4 project. Open this folder directly in the editor.
config_version=5

[application]
config/name="ホワイトハッカーラボ"
config/version="2.2.0"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A small, offline security company simulator."
config/use_custom_user_dir=true
config/custom_user_dir_name="WhiteHatLab"

[autoload]
Game="*res://scripts/game.gd"
Graphics="*res://scripts/graphics.gd"
Soundscape="*res://scripts/soundscape.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.08, 0.12, 0.15, 1)
anti_aliasing/quality/msaa_3d=0

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
